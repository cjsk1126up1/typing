{
  "rules": {
    ".read": false,
    ".write": false,
    "leaderboard": {
      ".read": "auth != null",
      "$userKey": {
        ".write": "auth != null && newData.exists() && root.child('practice').child($userKey).child('days').exists()",
        ".validate": "newData.hasChildren(['userId', 'highestScore', 'attemptCount', 'averageScore', 'averageSpeed', 'averageAccuracy', 'practiceDays', 'lastPracticeDate', 'bestDate', 'days', 'updatedAt']) && newData.child('userId').val() === root.child('practice').child($userKey).child('days').child(newData.child('lastPracticeDate').val()).child('userId').val() && newData.child('highestScore').val() === root.child('practice').child($userKey).child('days').child(newData.child('bestDate').val()).child('highestScore').val()",
        "userId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32" },
        "highestScore": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "attemptCount": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "averageScore": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "averageSpeed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "averageAccuracy": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "practiceDays": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "lastPracticeDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
        "bestDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "days": {
          "$date": {
            ".validate": "newData.hasChildren(['highestScore', 'attemptCount', 'totalScore', 'totalSpeed', 'totalAccuracy']) && newData.child('highestScore').val() === root.child('practice').child($userKey).child('days').child($date).child('highestScore').val() && newData.child('attemptCount').val() === root.child('practice').child($userKey).child('days').child($date).child('attemptCount').val()",
            "highestScore": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "attemptCount": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "totalScore": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "totalSpeed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "totalAccuracy": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "practice": {
      "$userKey": {
        "days": {
          ".read": "auth != null",
          "$date": {
            ".write": "auth != null && newData.exists() && $date.matches(/^\\d{4}-\\d{2}-\\d{2}$/)",
            ".validate": "newData.hasChildren(['userId', 'practiceDate', 'attemptCount', 'averageScore', 'highestScore', 'averageSpeed', 'averageAccuracy', 'totalPracticeSeconds', 'totalQuestions', 'attempts', 'updatedAt', 'schemaVersion']) && (!data.exists() || newData.child('userId').val() === data.child('userId').val())",
            "userId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32" },
            "practiceDate": { ".validate": "newData.val() === $date" },
            "attemptCount": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "averageScore": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "highestScore": { ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('averageScore').val()" },
            "averageSpeed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "averageAccuracy": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "totalPracticeSeconds": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "totalQuestions": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "updatedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "schemaVersion": { ".validate": "newData.val() === 1" },
            "attempts": {
              "$attemptId": {
                ".validate": "newData.hasChildren(['id', 'userId', 'date', 'completedAt', 'score', 'speed', 'accuracy', 'elapsedSeconds', 'completedQuestions']) && newData.child('id').val() === $attemptId && newData.child('date').val() === $date && newData.child('userId').val() === newData.parent().parent().child('userId').val() && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('speed').isNumber() && newData.child('speed').val() >= 0 && newData.child('accuracy').isNumber() && newData.child('accuracy').val() >= 0 && newData.child('accuracy').val() <= 100 && newData.child('elapsedSeconds').isNumber() && newData.child('elapsedSeconds').val() > 0 && newData.child('completedQuestions').isNumber() && newData.child('completedQuestions').val() >= 0"
              }
            },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
